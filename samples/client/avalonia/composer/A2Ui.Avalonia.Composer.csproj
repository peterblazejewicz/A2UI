<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>A2Ui.Avalonia.Composer</AssemblyName>
    <RootNamespace>A2Ui.Avalonia.Composer</RootNamespace>
    <UseAvalonia>true</UseAvalonia>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Default" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.0" />
    <!-- Conditional packages for better development experience -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../renderers/avalonia/src/A2Ui.Avalonia/A2Ui.Avalonia.csproj" />
    <ProjectReference Include="../../../../agent_sdks/dotnet/src/A2Ui.Core/A2Ui.Core.csproj" />
    <ProjectReference Include="../../../../agent_sdks/dotnet/src/AgUi.Protocol/AgUi.Protocol.csproj" />
  </ItemGroup>

</Project>
